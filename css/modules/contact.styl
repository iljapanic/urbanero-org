.links-list
  list-style-type none
  padding 0
  margin 0

  li
    display inline-block
    margin-top spacing
    margin-right spacing*0.5
    margin-left spacing*0.5

.contact
  margin-top spacing*1.5

.notice
  position sticky
  top 0
  z-index 100
  text-align center
  font-size small
  color gray
  padding (spacing * 0.5) spacing
  background-color white
  border-bottom 1px solid gray-light
  a
    color gray-dark